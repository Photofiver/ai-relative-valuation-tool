{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["!pip install yfinance pandas tabulate tqdm -q\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import yfinance as yf\n","import pandas as pd\n","import time\n","import warnings\n","from tqdm.notebook import tqdm\n","warnings.filterwarnings('ignore')\n","\n","def pobierz_metryki(ticker):\n","    try:\n","        stock = yf.Ticker(ticker.upper().strip())\n","        info = stock.info\n","        if not info or info.get('regularMarketPrice') is None:\n","            return {'Ticker': ticker, 'Blad': 'Brak danych'}\n","        def safe(val, div=1, ndigits=2):\n","            if val is None or val == 0: return None\n","            try: return round(float(val) / div, ndigits)\n","            except: return None\n","        return {\n","            'Ticker': ticker.upper(),\n","            'Nazwa': info.get('longName') or info.get('shortName', 'N/A'),\n","            'Sektor': info.get('sector', 'N/A'),\n","            'Branza': info.get('industry', 'N/A'),\n","            'Cena': info.get('regularMarketPrice'),\n","            'Market Cap (mln $)': safe(info.get('marketCap'), 1_000_000, 0),\n","            'EV (mln $)': safe(info.get('enterpriseValue'), 1_000_000, 0),\n","            'P/E (trailing)': info.get('trailingPE'),\n","            'P/E (forward)': info.get('forwardPE'),\n","            'PEG': info.get('pegRatio'),\n","            'P/B (C/WK)': info.get('priceToBook'),\n","            'P/S (C/Przychod)': info.get('priceToSalesTrailing12Months'),\n","            'EV/EBITDA': info.get('enterpriseToEbitda'),\n","            'EV/Revenue': info.get('enterpriseToRevenue'),\n","            'ROE (%)': safe(info.get('returnOnEquity'), 0.01, 1),\n","            'Marza netto (%)': safe(info.get('profitMargins'), 0.01, 1),\n","            'Wzrost przych. (%)': safe(info.get('revenueGrowth'), 0.01, 1),\n","            'Dlug/Kapital': info.get('debtToEquity'),\n","        }\n","    except Exception as e:\n","        return {'Ticker': ticker, 'Blad': str(e)[:80]}\n","\n","def stworz_tabele_duza(tickery, batch_size=25):\n","    print(f'Przetwarzam {len(tickery)} spółek w partiach po {batch_size}...')\n","    wszystkie_dane = []\n","    for i in tqdm(range(0, len(tickery), batch_size), desc='Partie'):\n","        batch = tickery[i:i+batch_size]\n","        for t in batch:\n","            wszystkie_dane.append(pobierz_metryki(t))\n","        time.sleep(1.5)  # żeby nie blokowało Yahoo\n","    df = pd.DataFrame(wszystkie_dane)\n","    if 'Blad' in df.columns:\n","        bledy = df[df['Blad'].notna()]\n","        if not bledy.empty:\n","            print(f'Problemy z {len(bledy)} spółkami: {list(bledy["Ticker"])}')\n","        df = df[df['Blad'].isna()].drop(columns=['Blad'], errors='ignore')\n","    if df.empty: return df\n","    kluczowe = ['P/E (trailing)', 'P/E (forward)', 'PEG', 'P/B (C/WK)', 'P/S (C/Przychod)', 'EV/EBITDA', 'EV/Revenue']\n","    for col in kluczowe:\n","        if col in df.columns:\n","            med = df[col].median()\n","            if pd.notna(med) and med > 0:\n","                df[f'{col} vs Med'] = (df[col] / med).round(2)\n","    vs = [c for c in df.columns if 'vs Med' in c]\n","    reszta = [c for c in df.columns if c not in vs]\n","    return df[reszta + vs]\n","\n","# ==================== WPISZ SWOJE TICKERY TUTAJ ====================\n","# Możesz wkleić nawet 100-150 tickerów naraz\n","tickery = ['MSFT', 'GOOGL', 'AMZN', 'META', 'AAPL', 'NVDA', 'TSLA', 'AMD', 'INTC', 'ORCL']  # przykład - zmień na swoje\n","# =======================================================\n","\n","df = stworz_tabele_duza(tickery, batch_size=20)\n","if not df.empty:\n","    print('\n' + '='*95)\n","    print('TABELA WYCENY PORÓWNAWCZEJ (duża lista)')\n","    print('='*95)\n","    try:\n","        print(df.to_markdown(index=False, floatfmt='.2f'))\n","    except:\n","        print(df.to_string(index=False))\n","\n","    print('\n' + '='*95)\n","    print('SKOPIUJ PROMPT PONIŻEJ I WKLEJ DO GROK')\n","    print('='*95)\n","\n","    prompt = f'''Jestes doswiadczonym analitykiem inwestycyjnym (styl Buffett + surowa szczerosc).\\n\\nPrzeanalizuj tabele wyceny porownawczej ponizej (duża grupa spółek).\\n\\nCel: Które spółki są względnie tanie/drogie na tle grupy? Zwóć uwagę na jakość fundamentów.\\n\\nFormat:\\n1. Podsumowanie grupy\\n2. Top 5 najtańszych wg średniej vs Med\\n3. Top 5 najdroższych wg średniej vs Med\\n4. Najciekawsze okazje + ryzyka\\n5. Wnioski (z disclaimerem)\\n\\nDane:\\n{df.to_markdown(index=False, floatfmt='.2f')}\n'''\n","    print(prompt)\n"]}]}